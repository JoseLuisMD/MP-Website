---
// Fuentes alojadas en la propia web (paquetes @fontsource), no en Google Fonts: más rápido y sin enviar la IP
// de los visitantes a Google. Solo el juego latino, que incluye todo lo del español (tildes, ñ, ¡, ¿).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/silkscreen/latin-400.css';
import '@fontsource/silkscreen/latin-700.css';
import '../styles/global.css';
import { ruta } from '../lib/datos.js';
import { REDES } from '../data/redes.js';

const {
  titulo = 'Mundos Pixelados | Análisis, curiosidades y tops de videojuegos',
  descripcion = 'Somos 2 amigos a los que les apasionan los videojuegos. Análisis, curiosidades, tops, estadísticas y noticias en vídeo.',
} = Astro.props;

// Estadísticas de visitas con GoatCounter (sin cookies, no hace falta banner). Panel: https://mundospixelados.goatcounter.com
// Si la cuenta usa otro código, se cambia aquí. Los clics se cuentan con el atributo data-goatcounter-click.
const GOATCOUNTER = 'mundospixelados';

const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(ruta('og.jpg'), Astro.site);

// Datos estructurados (schema.org): le dicen a Google qué es la web y cuáles son sus redes oficiales
const inicio = new URL('/', Astro.site).href;
const datos = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${inicio}#organizacion`,
      name: 'Mundos Pixelados',
      url: inicio,
      logo: new URL(ruta('logo.jpg'), Astro.site).href,
      sameAs: REDES.filter((r) => r.url).map((r) => r.url),
    },
    {
      '@type': 'WebSite',
      '@id': `${inicio}#web`,
      name: 'Mundos Pixelados',
      url: inicio,
      inLanguage: 'es-ES',
      publisher: { '@id': `${inicio}#organizacion` },
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content="Mundos Pixelados" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#23628e" />
    <link rel="icon" type="image/png" href={ruta('favicon.png')} />
    <link rel="apple-touch-icon" href={ruta('apple-touch-icon.jpg')} />
    <link rel="sitemap" href={ruta('sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(datos)} />
    {GOATCOUNTER && (
      <script is:inline async data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
