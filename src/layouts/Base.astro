---
import '../styles/global.css';
import { ruta } from '../lib/datos.js';

const { titulo = 'Mundos Pixelados', descripcion = 'Vídeos, shorts y noticias de videojuegos de Mundos Pixelados.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ruta('og.jpg'), Astro.site)} />
    <meta name="theme-color" content="#23628e" />
    <link rel="icon" type="image/png" href={ruta('favicon.png')} />
    <link rel="apple-touch-icon" href={ruta('apple-touch-icon.jpg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
