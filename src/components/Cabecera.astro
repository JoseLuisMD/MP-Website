---
import { ruta } from '../lib/datos.js';
---
<header class="cabecera">
  <span class="nube nube--1" aria-hidden="true"></span>
  <span class="nube nube--2" aria-hidden="true"></span>
  <span class="nube nube--3" aria-hidden="true"></span>
  <span class="cielo" aria-hidden="true">
    <span class="nube-grande nube-grande--1"></span>
    <span class="nube-grande nube-grande--2"></span>
    <span class="nube-grande nube-grande--3"></span>
  </span>
  <div class="contenedor cabecera__contenido">
    <a href={ruta('/')} class="marca" aria-label="Mundos Pixelados, inicio">
      <img class="marca__logo" src={ruta('logo.jpg')} alt="" width="320" height="320" />
      <div class="marca__texto">
        <h1 class="marca__nombre">Mundos <span class="marca__rojo">Pixelados</span></h1>
        <span class="marca__lema">Somos 2 amigos a los que les apasionan los videojuegos. ¡Aquí encontrarás análisis, curiosidades, tops, estadísticas, noticias, y mucho más!</span>
      </div>
    </a>
  </div>
</header>
