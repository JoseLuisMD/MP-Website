---
import * as iconos from 'simple-icons';
import { REDES } from '../data/redes.js';

// Icono genérico de enlace por si simple-icons no tiene el de alguna red
const ENLACE = 'M10.6 13.4a1 1 0 0 1 0-1.4l3.4-3.4a1 1 0 1 1 1.4 1.4L12 13.4a1 1 0 0 1-1.4 0zM7 18a4 4 0 0 1-2.8-6.8l2.1-2.1a1 1 0 1 1 1.4 1.4l-2.1 2.1a2 2 0 0 0 2.8 2.8l2.1-2.1a1 1 0 0 1 1.4 1.4l-2.1 2.1A4 4 0 0 1 7 18zm8.3-3.9a1 1 0 0 1-.7-1.7l2.1-2.1a2 2 0 0 0-2.8-2.8l-2.1 2.1a1 1 0 0 1-1.4-1.4l2.1-2.1a4 4 0 0 1 5.6 5.6L16 13.8a1 1 0 0 1-.7.3z';

const redes = REDES.filter((r) => r.url).map((r) => {
  const icono = iconos[r.icono];
  return { ...r, path: icono?.path ?? ENLACE, color: r.color ?? (icono ? `#${icono.hex}` : 'var(--superficie-2)') };
});
---
<section class="panel" aria-labelledby="titulo-enlaces">
  <h2 class="panel__titulo" id="titulo-enlaces">¡Síguenos!</h2>
  <ul class="enlaces">
    {redes.map((r) => (
      <li>
        <a class="enlace" href={r.url} target="_blank" rel="noopener" style={`--color-red: ${r.color}`}>
          <span class="enlace__icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={r.path} /></svg></span>
          <span class="enlace__nombre">{r.nombre}</span>
          <svg class="enlace__flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      </li>
    ))}
  </ul>
</section>
